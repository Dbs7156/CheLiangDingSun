# systemd unit template for the vehicle damage detection API.
# Copy to /etc/systemd/system/vehicle-damage.service, then replace __USER__
# and __PROJECT_ROOT__.
#
# The service user must own (or be able to write) __PROJECT_ROOT__/backend:
# the app creates history.db and temporary upload files there.
#
# Keep exactly one worker. Video jobs are stored in process memory and are
# polled by the browser, so multiple workers would make job lookups flaky.

[Unit]
Description=Vehicle Damage Detection API
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_ROOT__/backend
ExecStart=__PROJECT_ROOT__/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
