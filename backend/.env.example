# auto：有模型文件就用模型，没有就用演示数据
# demo：强制演示模式
# model：只允许正式模型
DETECTION_MODE=auto

# 模型与类别文件（相对于 backend/）
MODEL_PATH=best.onnx
CLASSES_PATH=classes.json
MODEL_NAME=车辆受损检测模型

# ONNX Runtime
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
MODEL_INPUT_SIZE=640
MODEL_OUTPUT_FORMAT=auto
MODEL_BOX_FORMAT=auto
MODEL_INPUT_COLOR=rgb
MODEL_MAX_DETECTIONS=100

# FastAPI / 会话
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_NAME=cs_session
SESSION_MAX_AGE_DAYS=30
COOKIE_SECURE=false

# 检测记录
HISTORY_DB_PATH=history.db
HISTORY_RETENTION_DAYS=30
HISTORY_MAX_PER_SESSION=100

# 视频处理临时文件目录，可选；默认选择系统临时目录
# UPLOAD_TMP_DIR=C:\temp\vehicle-damage-uploads

# 上传限制
MAX_IMAGE_MB=15
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_MB=200
MAX_VIDEO_SECONDS=180
VIDEO_SAMPLE_FPS=3
VIDEO_WORKERS=2
JOB_TTL_SECONDS=3600
THUMBNAIL_MAX_WIDTH=720
